{
  "name": "syncpeer",
  "version": "0.4.0-rc.7",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:block-reuse": "npm run build:core && node --experimental-strip-types --test scripts/test-block-reuse.ts",
    "test": "npm run test:diagnostics",
    "test:connection": "npm run build:core && node --experimental-strip-types --test scripts/test-connection-management.ts",
    "test:transfer-notifications": "npm run build:core && node --experimental-strip-types --test scripts/test-transfer-notifications.ts",
    "test:app-theme": "node --experimental-strip-types --test scripts/test-app-theme.ts scripts/test-icon-theme.ts",
    "test:app-notices": "node --experimental-strip-types --test scripts/test-connection-notices.ts",
    "test:favorite-sync": "node --experimental-strip-types --test scripts/test-favorite-sync-policies.ts",
    "test:quic:runtime": "node --experimental-quic --experimental-strip-types scripts/test-node-quic-runtime.ts",
    "test:quic:cli": "npm run build:cli && node --experimental-quic --experimental-strip-types scripts/test-node-quic-integration.ts",
    "test:diagnostics": "node --experimental-strip-types scripts/test-diagnostics.ts",
    "test:e2e": "node --experimental-strip-types scripts/test-e2e.ts",
    "test:e2e:android": "node scripts/test-android-e2e.mjs",
    "security:export-dependabot": "node scripts/export-dependabot-alerts.mjs",
    "release": "node scripts/release.mjs",
    "lint": "eslint eslint.config.mjs \"packages/**/*.{js,mjs,cjs,ts,svelte}\" \"scripts/**/*.{js,mjs,cjs,ts,svelte}\"",
    "download:syncthing": "node scripts/download-syncthing.mjs",
    "test:server": "node --experimental-strip-types scripts/test-dev.ts --server",
    "test:client": "node --experimental-strip-types scripts/test-dev.ts --client",
    "test:lan:server": "node --experimental-strip-types scripts/test-lan.ts --server",
    "test:lan:client": "node --experimental-strip-types scripts/test-lan.ts --client",
    "test:lan:server:firewall": "node --experimental-strip-types scripts/test-lan.ts --server --open-firewall",
    "test:lan:client:firewall": "node --experimental-strip-types scripts/test-lan.ts --client --open-firewall",
    "build": "npm run build:cli && npm run build:app && npm run build:tauri",
    "build:core": "npm run build -w @syncpeer/core",
    "build:cli": "npm run build:core && npm run build -w @syncpeer/cli",
    "build:app": "npm run build -w @syncpeer/app",
    "build:tauri": "npm run build -w @syncpeer/tauri-shell",
    "build:tauri:bundle": "npm run build:bundle -w @syncpeer/tauri-shell",
    "build:tauri:bundle:appimage": "npm run build:bundle:appimage -w @syncpeer/tauri-shell",
    "build:tauri:bundle:deb": "npm run build:bundle:deb -w @syncpeer/tauri-shell",
    "build:tauri:bundle:flatpak": "npm run build:bundle:flatpak -w @syncpeer/tauri-shell",
    "typecheck:app": "npm run typecheck -w @syncpeer/app",
    "build:android:init": "npm run android:init -w @syncpeer/tauri-shell",
    "build:android": "npm run build:android:prod",
    "build:android:prod": "scripts/build-android-prod-with-secrets.sh",
    "sync:android:secrets": "scripts/sync-android-signing-secrets.sh",
    "build:android:dev": "npm run build:android:dev -w @syncpeer/tauri-shell && node scripts/copy-android-apk.mjs debug",
    "build:android:e2e": "npm run build:android:e2e -w @syncpeer/tauri-shell",
    "android:install:diagnose": "scripts/diagnose-android-install.sh dist/syncpeer-android-release-arm64-v8a.apk dev.syncpeer.app",
    "android:dev": "npm run android:dev -w @syncpeer/tauri-shell",
    "icons:generate": "npm run icons:generate -w @syncpeer/tauri-shell",
    "icons:ensure": "node scripts/ensure-tauri-icons.mjs",
    "icons:ensure:android": "node scripts/ensure-tauri-icons.mjs --android",
    "build:dev": "npm run build && npm run dev",
    "dev": "npm run dev -w @syncpeer/tauri-shell 2>&1 | tee output.log"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@wdio/cli": "^9.31.2",
    "@wdio/globals": "^9.31.1",
    "@wdio/local-runner": "^9.31.2",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-service": "^1.3.0",
    "@wdio/tauri-plugin": "^1.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "expect-webdriverio": "^6.0.7",
    "globals": "^17.11.0",
    "tsx": "^4.20.3",
    "typescript-eslint": "^8.68.0",
    "webdriverio": "^9.31.2"
  }
}
