<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application
    android:allowBackup="false"
    android:label="Syncpeer synthetic document editor"
    android:supportsRtl="false">
    <activity
      android:name=".GrantActivity"
      android:excludeFromRecents="true"
      android:exported="true"
      android:theme="@style/SyntheticEditorGrantTheme">
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:scheme="content" android:mimeType="text/plain" />
      </intent-filter>
    </activity>
    <provider
      android:name=".EditorCommandProvider"
      android:authorities="dev.syncpeer.synthetic.editor.commands"
      android:exported="true" />
  </application>
</manifest>
