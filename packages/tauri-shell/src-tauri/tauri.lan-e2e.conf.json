{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build -w @syncpeer/app -- --mode lan-e2e",
    "features": ["lan-e2e"]
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "lan-e2e",
          "description": "Opt-in permissions for real Tauri LAN integration tests.",
          "windows": ["*"],
          "permissions": [
            "core:default",
            "wdio:default"
          ]
        }
      ]
    }
  }
}
